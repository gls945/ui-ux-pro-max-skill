# URL publique du site (sans slash final) — utilisée pour le SEO, le sitemap et Open Graph
NEXT_PUBLIC_SITE_URL=https://www.exemple-a-remplacer.fr

# Lien officiel de l'événement Calendly de 20 minutes (laisser vide tant qu'il n'est pas fourni)
NEXT_PUBLIC_CALENDLY_URL=

# Envoi des e-mails du formulaire via Resend (https://resend.com) — NE JAMAIS COMMITER LA CLÉ
RESEND_API_KEY=
# Adresse d'expédition vérifiée dans Resend (ex. "Site Maison Kaya <contact@votre-domaine.fr>")
CONTACT_FROM_EMAIL=
# Destinataire des demandes
CONTACT_TO_EMAIL=maisonkayaconciergerie@gmail.com
